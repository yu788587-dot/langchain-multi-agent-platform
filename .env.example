# 复制本文件为 .env 并填入真实配置。.env 已被 .gitignore 排除，绝不提交。

# SiliconFlow API 密钥（必填）：https://cloud.siliconflow.cn 控制台获取
SILICONFLOW_API_KEY=sk-0123456789abcdef0123456789abcdef0123456789abcdef

# OpenAI 兼容端点（默认 SiliconFlow）
BASE_URL=https://api.siliconflow.cn/v1

# 模型名（SiliconFlow 必须带命名空间）
MODEL=deepseek-ai/DeepSeek-V3

# Tavily 搜索 API 密钥（可选，留空则回退内置演示医疗数据）
TAVILY_API_KEY=

# 审核者要求修订的最大次数（超过则强制定稿）
MAX_REVISIONS=2
